# Environnement — copier vers .env.local et remplir

# "production" | "staging" | "development"
# En dehors de production, le site est en noindex global (Phase 4)
NEXT_PUBLIC_ENV=development

# URL canonique du site (sans slash final)
NEXT_PUBLIC_SITE_URL=https://depannagescooter.fr

# Google Analytics 4 — measurement ID (ex. G-XXXXXXXXXX)
NEXT_PUBLIC_GA_ID=

# Formulaire de contact — webhook optionnel (Slack, n8n, etc.)
CONTACT_WEBHOOK_URL=

# Email de réception des demandes de rappel
CONTACT_EMAIL=contact@depannagescooter.fr

# Secret pour rate limiting (générer une chaîne aléatoire)
CONTACT_RATE_LIMIT_SECRET=TODO-generer-un-secret

# SMTP ou service email (Phase 6)
SMTP_HOST=
SMTP_PORT=
SMTP_USER=
SMTP_PASS=
